{
  "name": "@SoftbotMX/softbot-ui",
  "version": "1.6.1",
  "type": "module",
  "files": [
    "dist",
    "dist/assets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.mjs",
      "require": "./dist/editor.cjs"
    },
    "./emoji": {
      "types": "./dist/emoji.d.ts",
      "import": "./dist/emoji.mjs",
      "require": "./dist/emoji.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftbotMX/softbot-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && npm run build:css && cp -r src/assets dist",
    "build:css": "NODE_ENV=production postcss src/main.css -o dist/styles.css",
    "dev": "vite",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.31.4",
    "@tiptap/extension-link": ">=3.31.4",
    "@tiptap/extension-list": ">=3.31.4",
    "@tiptap/pm": ">=3.31.4",
    "@tiptap/react": ">=3.31.4",
    "@tiptap/starter-kit": ">=3.31.4",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.1",
    "@eslint/js": "9.37.0",
    "@storybook/addon-a11y": "10.2.1",
    "@storybook/addon-docs": "10.2.1",
    "@storybook/addon-onboarding": "10.2.1",
    "@storybook/addon-vitest": "10.2.1",
    "@storybook/react-vite": "10.2.1",
    "@tailwindcss/postcss": "4.1.14",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "24.7.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.21",
    "cssnano": "7.1.1",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-react-refresh": "0.4.23",
    "eslint-plugin-storybook": "9.1.10",
    "frimousse": "0.4.0",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.6",
    "postcss-cli": "11.0.1",
    "postcss-html": "1.8.0",
    "postcss-import": "16.1.1",
    "postcss-nesting": "13.0.2",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "10.2.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-order": "7.0.0",
    "stylelint-prettier": "5.0.3",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.11",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@3.8.7",
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  }
}
